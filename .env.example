# GonkaRouter, the AI inference gateway. Copy to .env and fill.
# Get a key at https://gonkarouter.io -> Dashboard -> Create API Key.
# NEVER put the real key in this file. It is committed; .env is not.
GONKA_API_KEY=

# Two base URLs, because the SDKs append different paths and one value cannot
# serve both. Verified 2026-08-29: /v1/v1/messages returns 404.
#   OpenAI-style clients append /chat/completions  -> base must end in /v1
#   Anthropic-style clients append /v1/messages    -> base must NOT end in /v1
# See docs/TRD.md section 1.
GONKA_BASE_URL_OPENAI=https://api.gonkarouter.io/v1
GONKA_BASE_URL_ANTHROPIC=https://api.gonkarouter.io

# Exact ids from GET /v1/models, case- and slash-sensitive.
# The website's Models page shows SHORT ids that all return 400. See TRD.md s3.
GONKA_MODEL_FAST=deepseek-ai/DeepSeek-V4-Flash-0731
GONKA_MODEL_DEEP=moonshotai/Kimi-K2.6
GONKA_MODEL_THIRD=MiniMaxAI/MiniMax-M2.7
