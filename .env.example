# Cekgu configuration contract. See docs/TRD.md section 8.
# Names only; this file is committed. Real values live in .env, which is gitignored, and in a
# GitHub Actions secret of the same name. Every key here is server-side and never reaches the
# client bundle.

GONKA_API_KEY=                                          # sk-… from the Dashboard
GONKA_BASE_URL_OPENAI=https://api.gonkarouter.io/v1     # The OpenAI surface only. TRD section 1

DATABASE_URL=                                           # Neon Postgres, pooled, sslmode=require

BETTER_AUTH_SECRET=                                     # 32+ random bytes; signs sessions
BETTER_AUTH_URL=                                        # Public origin of the deployment, no trailing slash
GOOGLE_CLIENT_ID=                                       # Optional. Absent, Google sign-in disappears
GOOGLE_CLIENT_SECRET=

GUEST_EMAIL=                                            # The one seeded Guest user. TRD section 12
GUEST_PASSWORD=                                         # Server-side only, for POST /api/auth/guest

MASCOT_ENABLED=false                                    # FR-MASCOT-1 feature flag. true for the demo
WORKER_CONCURRENCY=                                     # Concurrent worker loops, 1–4. Default 1

# Optional. Transcription for Upload a Paper, and it decides nothing. TRD section 20.
# Absent, uploads answer 503 and the rest of the product is unchanged.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash                           # Verify against GET /v1beta/models first

# Optional. Live retrieval for cross-verification, and it decides nothing. TRD section 22.
# Absent, the readers work from their own knowledge and every verdict fires as before.
TAVILY_API_KEY=

# The record assistant. TRD section 21. Left blank so env.ts picks the pair: gonka, the
# compliant path, with MiniMaxAI/MiniMax-M2.7. Setting a provider without its model breaks it.
CHAT_PROVIDER=                                          # gemini | gonka. Default gonka
CHAT_MODEL=                                             # Never …-flash-lite. TRD section 20
