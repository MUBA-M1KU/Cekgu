# GonkaRouter — AI inference gateway. Copy to .env.local and fill.
# Generate your key at https://gonkarouter.io -> Dashboard -> Create API Key.
# Never commit .env.local.
GONKA_API_KEY=

# Gateway base URL. Domain root, no /v1 suffix — Anthropic-style clients
# append /v1/messages themselves. OpenAI-style clients need the /v1 suffix.
GONKA_BASE_URL=https://api.gonkarouter.io

# Model ids are case- and slash-sensitive. Verify against /v1/models with
# your own key before pinning — catalogs differ per gateway plan.
GONKA_MODEL_PRIMARY=moonshotai/Kimi-K2.6
GONKA_MODEL_SECONDARY=MiniMaxAI/MiniMax-M2.7
