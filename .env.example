# Cekgu configuration contract. See docs/TRD.md section 8.
# This file is committed and carries names only. Real values live in .env, which is gitignored,
# and in a GitHub Actions secret of the same name for every deployment.

GONKA_API_KEY=                                          # sk-… from the Dashboard. Server only, never in the client bundle
GONKA_BASE_URL_OPENAI=https://api.gonkarouter.io/v1     # The product uses the OpenAI surface only. See TRD section 1

DATABASE_URL=                                           # Neon Postgres connection string, pooled, sslmode=require

BETTER_AUTH_SECRET=                                     # 32+ random bytes; signs sessions
BETTER_AUTH_URL=                                        # Public origin of the deployment, no trailing slash
GOOGLE_CLIENT_ID=                                       # Google OAuth web client
GOOGLE_CLIENT_SECRET=

GUEST_EMAIL=                                            # The one seeded Guest user. See TRD section 12
GUEST_PASSWORD=                                         # Used server-side only by POST /api/auth/guest

MASCOT_ENABLED=false                                    # FR-MASCOT-1 feature flag. true for the demo

# Transcription only, and only for Upload a Paper. The track's mandatory rule binds AI *reasoning and
# verification* to the Gonka Network; turning pixels and PDF bytes into text is neither, and no Gonka
# model except Kimi can see an image at all. Every judgement about what the paper says is still made
# by two Gonka models with request ids. See docs/TRD.md section 20 and docs/brief.md.
# Absent, Upload a Paper is simply off and the rest of the product is unchanged.
GEMINI_API_KEY=                                         # Server only, never in the client bundle
GEMINI_MODEL=gemini-2.5-flash                           # Verify against GET /v1beta/models before changing this

# The record assistant, docs/TRD.md section 21. gemini phrases answers off the gateway from facts the
# Gonka readers already produced; gonka keeps every inference on it. Both paths are built.
CHAT_PROVIDER=gemini                                    # gemini | gonka
CHAT_MODEL=gemini-2.5-flash                             # Separate from GEMINI_MODEL. Never …-flash-lite
